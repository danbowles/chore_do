<div class="flex h-screen overflow-hidden">
  <aside class="app-sidebar absolute left-0 top-0 z-9999 flex h-screen w-72.5 flex-col overflow-y-hidden  duration-300 ease-linear bg-boxdark lg:static lg:translate-x-0 -translate-x-full">
    <div class="flex items-center justify-between gap-2 px-6 py-5.5 lg:py-6.5">
      <%!-- Header --%>
      <div class="flex items-center gap-2">
        <img
          src={~p"/images/chore-do.svg"}
          alt="ChoreDo Logo"
          class="h-12 w-12 bg-slate-100 rounded-md border-primary border-2"
        />
        <span class="ml-2 text-2xl font-bold text-gray-100">Chore-Do</span>
      </div>
      <button
        class="block text-bodydark2 lg:hidden"
        phx-click={
          JS.add_class("-translate-x-full", to: ".app-sidebar")
          |> JS.remove_class("translate-x-0", to: ".app-sidebar")
        }
      >
        <.icon name="hero-arrow-left" class="w-8 h-8 block" />
      </button>
    </div>
    <div class="no-scrollbar flex flex-col overflow-y-auto duration-300 ease-linear h-full">
      <!-- Sidebar Menu -->
      <nav class="mt-5 px-4 py-4 lg:mt-9 lg:px-6 text-gray-200">
        <!-- Navigation Group -->
        <h3 class="mb-4 ml-4 text-sm font-medium text-bodydark2 uppercase">Menu</h3>
        <ul class="mb-6 flex flex-col gap-1.5">
          <.dashboard_menu_item
            :if={!@current_user.member || @current_user.member.role == :admin}
            icon_name="hero-home-modern"
            href={~p"/household"}
            active={@current_page == :household}
          >
            My Household
          </.dashboard_menu_item>
          <.dashboard_menu_item
            icon_name="hero-star"
            href={~p"/chores"}
            active={@current_page == :chores}
          >
            My Chores
          </.dashboard_menu_item>
        </ul>
      </nav>
      <nav class="mt-auto mb-0 px-4 py-4 lg:px-6 text-gray-200">
        <!-- Navigation Group -->
        <div>
          <h3 class="mb-4 ml-4 text-sm font-medium text-bodydark2 uppercase">Account</h3>
          <ul class="mb-6 flex flex-col gap-1.5">
            <.dashboard_menu_item
              icon_name="hero-adjustments-horizontal"
              href={~p"/users/settings"}
              active={@current_page == :user_settings}
            >
              Settings
            </.dashboard_menu_item>
            <.dashboard_menu_item
              href={~p"/logout"}
              icon_name="hero-arrow-left-end-on-rectangle"
              method="delete"
            >
              Logout
            </.dashboard_menu_item>
          </ul>
        </div>
      </nav>
    </div>
  </aside>
  <%!-- CONTENT --%>
  <div class="relative flex flex-1 flex-col overflow-y-auto overflow-x-hidden">
    <%!-- HEADER CONTENT --%>
    <header class="sticky top-0 z-1 flex w-full bg-white drop-shadow-1">
      <div class="flex flex-grow items-center justify-between px-4 py-4 shadow-2 md:px-6 2xl:px-11">
        <div class="flex items-center gap-2 sm:gap-4 lg:hidden">
          <button
            class="block text-body outline outline-1 rounded-sm"
            phx-click={JS.add_class("translate-x-0", to: ".app-sidebar")}
          >
            <.icon name="hero-bars-3" class="w-8 h-8 block" />
          </button>
          <.link class="block flex-shrink-0 lg:hidden" href={~p"/"}>
            <img src={~p"/images/chore-do.svg"} alt="ChoreDo Logo" class="h-12 w-12" />
          </.link>
        </div>
        <div class="flex items-center gap-3 2xsm:gap-7 ml-auto">
          <%!-- User area --%>
          <div class="relative">
            <a
              href="#"
              class="flex items-center gap-2"
              phx-click={
                JS.toggle(to: ".user-area-dropdown", display: "flex")
                |> JS.toggle_class("rotate-180", to: ".user-area-toggle-icon")
              }
            >
              <span class="hidden text-right lg:block">
                <%= if @current_user do %>
                  <span class="block text-sm font-medium text-black">
                    <%= @current_user.first_name %> <%= @current_user.last_name %>
                  </span>
                <% end %>
                <span class="block text-xs font-light">UX Designer</span>
              </span>
              <.icon name="hero-user-circle" class="w-8 h-8 block" />
              <.icon
                name="hero-chevron-down"
                class="user-area-toggle-icon w-6 h-6 hidden sm:block"
              />
            </a>
            <%!-- Dropdown start --%>
            <div class="user-area-dropdown absolute right-0 mt-4 w-62.5 flex-col rounded-sm border border-stroke bg-white shadow-default hidden">
              <ul class="flex flex-col gap-5 border-b border-stroke px-6 py-7.5">
                <li>
                  <.link
                    href={~p"/users/settings"}
                    class="flex items-center gap-3.5 text-md font-medium duration-300 ease-in-out hover:text-primary lg:text-base"
                  >
                    <.icon name="hero-cog-6-tooth" class="w-6 h-6" /> Your Account
                  </.link>
                </li>
                <li>
                  <.link
                    href={~p"/logout"}
                    method="delete"
                    class="flex items-center gap-3.5 text-md font-medium duration-300 ease-in-out hover:text-primary lg:text-base"
                  >
                    <.icon name="hero-arrow-left-end-on-rectangle" class="w-6 h-6" /> Logout
                  </.link>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </header>
    <main>
      <div class="mx-auto max-w-screen-2xl p-4 md:p-6 2xl:p-10">
        <%!-- <pre class="block max-w-screen-xsm text-wrap">
        <%= inspect(@current_user) %></pre> --%>
        <%!-- <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6 xl:grid-cols-4 2xl:gap-7.5 b"> --%>
        <%= @inner_content %>
        <%!-- </div> --%>
      </div>
    </main>
  </div>
</div>
<.flash_group flash={@flash} />
